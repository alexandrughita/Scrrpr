# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NIMFOMANE_USER: Your username for nimfomane.com
NIMFOMANE_USER=
# NIMFOMANE_PASS: Your password for nimfomane.com
NIMFOMANE_PASS=

# APPROAPE_ADMIN_TOKEN: Admin token for approape.ro API
APPROAPE_ADMIN_TOKEN=

# API_KEY: Secret Bearer key required by external servers (e.g. Approape / Vercel)
# Sent in header: Authorization: Bearer <API_KEY> or X-Api-Key: <API_KEY>
API_KEY=

# BURSA_API_KEY: Optional dedicated API key for /api/v1/bursa/* (falls back to API_KEY)
BURSA_API_KEY=

# BURSA_BASE_URL: Upstream base URL for Bursa discovery (default: https://bursaplacerilor.com)
BURSA_BASE_URL=https://bursaplacerilor.com

# BURSA_SCRAPE_INTERVAL_MS: Interval in ms between automated sweeps (default: 604800000 = 7 days / weekly)
BURSA_SCRAPE_INTERVAL_MS=604800000

# BURSA_SCHEDULER_ENABLED: Set to "false" to disable automatic scheduled sweeps
BURSA_SCHEDULER_ENABLED=true

# BURSA_RUN_ON_STARTUP: Set to "true" to trigger a sweep immediately on server start even if prior runs exist
BURSA_RUN_ON_STARTUP=false

# BURSA_MAX_PAGES: Maximum pagination pages scanned per discovery sweep (default: 25)
BURSA_MAX_PAGES=25

# BURSA_REQUEST_DELAY_MS: Polite delay in ms between page requests (default: 500)
BURSA_REQUEST_DELAY_MS=500

